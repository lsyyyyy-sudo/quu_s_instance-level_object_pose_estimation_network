# 统一换行符，避免在 Windows 上开发的脚本被提交成 CRLF 后在 Linux 上跑不起来
* text=auto eol=lf

# Shell 脚本必须保持 LF（渲染脚本要在 Ubuntu 上执行）
*.sh   text eol=lf
*.bash text eol=lf

# Windows 批处理保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.npy  binary
*.npz  binary
*.pt   binary
*.pth  binary
*.ckpt binary
*.onnx binary
*.ply  binary
*.zip  binary

# 让 diff / 语言统计更准确
*.md   text
*.py   text
*.yaml text
*.yml  text
*.json text
*.toml text
*.cfg  text
*.txt  text
